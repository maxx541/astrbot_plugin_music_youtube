{
    "default_player_name": {
        "description": "默认点歌平台",
        "desc_i18n": {
            "en": "Default music platform",
            "zh_CN": "默认点歌平台",
            "zh_TW": "預設點歌平台"
        },
        "hint": "YouTube 为唯一可用平台",
        "type": "string",
        "default": "YouTube音乐",
        "invisible": true
    },
    "song_limit": {
        "description": "搜索歌曲数量限制",
        "type": "int",
        "slider": {
            "min": 1,
            "max": 20,
            "step": 1
        },
        "default": 5
    },
    "select_mode": {
        "description": "选择模式",
        "type": "string",
        "options": ["text", "single"],
        "labels": ["文本模式", "单曲模式"],
        "default": "text"
    },
    "send_modes": {
        "description": "发送模式",
        "hint": "排在前面的模式优先，发送失败时自动尝试下一种",
        "type": "list",
        "options": [
            "record(语音模式)",
            "file(文件模式)",
            "text(文本模式)"
        ],
        "default": [
            "record(语音模式)",
            "file(文件模式)",
            "text(文本模式)"
        ]
    },
    "record_supported": {
        "description": "支持发语音的消息平台",
        "type": "list",
        "options": [
            "aiocqhttp",
            "dingtalk",
            "discord",
            "kook",
            "lark",
            "line",
            "misskey",
            "qq_official",
            "qq_official_webhook",
            "satori",
            "telegram",
            "webchat",
            "wecom",
            "wecom_ai_bot",
            "weixin_oc"
        ],
        "default": [
            "aiocqhttp",
            "dingtalk",
            "lark",
            "line",
            "qq_official",
            "qq_official_webhook",
            "satori",
            "telegram",
            "webchat",
            "wecom"
        ]
    },
    "file_supported": {
        "description": "支持发文件的消息平台",
        "type": "list",
        "options": [
            "aiocqhttp",
            "dingtalk",
            "discord",
            "kook",
            "lark",
            "line",
            "misskey",
            "qq_official",
            "qq_official_webhook",
            "satori",
            "telegram",
            "webchat",
            "wecom",
            "wecom_ai_bot",
            "weixin_oc"
        ],
        "default": [
            "aiocqhttp",
            "discord",
            "dingtalk",
            "lark",
            "line",
            "misskey",
            "qq_official",
            "qq_official_webhook",
            "satori",
            "telegram",
            "webchat",
            "weixin_oc"
        ]
    },
    "enable_lyrics": {
        "description": "是否启用歌词显示",
        "hint": "开启后在发送歌曲后附加歌词图片",
        "type": "bool",
        "default": true
    },
    "youtube_enable_subtitle": {
        "description": "启用 YouTube CC 字幕",
        "hint": "开启后自动下载 YouTube 视频的 CC 字幕作为歌词",
        "type": "bool",
        "default": true
    },
    "youtube_subtitle_priority": {
        "description": "YouTube 字幕优先级（按顺序尝试）",
        "hint": "支持语言代码：zh-Hans(简体中文)、zh-Hant(繁体中文)、en(英文)、ja(日文)、ko(韩文)等",
        "type": "list",
        "options": [
            "zh-Hans",
            "zh-Hant",
            "en",
            "ja",
            "ko",
            "es",
            "fr",
            "de",
            "ru",
            "pt",
            "it"
        ],
        "default": [
            "zh-Hans",
            "zh-Hant",
            "en"
        ]
    },
    "timeout": {
        "description": "点歌操作的超时时长（秒）",
        "type": "int",
        "slider": {
            "min": 30,
            "max": 300,
            "step": 10
        },
        "default": 30
    },
    "timeout_recall": {
        "description": "撤回选歌消息",
        "hint": "达到超时时长后撤回选歌消息（仅aiocqhttp平台支持）",
        "type": "bool",
        "default": true
    },
    "clear_cache": {
        "description": "重载插件时清空缓存",
        "hint": "清空songs和youtube_subtitles目录",
        "type": "bool",
        "default": true
    },
    "proxy": {
        "description": "代理地址",
        "hint": "如 http://127.0.0.1:7890，留空则直连",
        "type": "string",
        "default": ""
    },
    "playlist_limit": {
        "description": "歌单容量限制",
        "hint": "用户歌单最多能添加多少首歌",
        "type": "int",
        "slider": {
            "min": 10,
            "max": 200,
            "step": 1
        },
        "default": 100
    }
}
